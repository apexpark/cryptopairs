{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apexpark.dev/contracts/autopilot_dynamic_allowlist_decision_v2.schema.json",
  "title": "AutopilotDynamicAllowlistDecisionV2",
  "description": "Non-actuating AUTO-2C v2 decision for independent AUTO-2D paper-only verification. The historical transition policy and the separately versioned first bounded paper experiment route both permit bounded additions and deterministic truncation but grant no configuration, eligibility, later-promotion, live, execution, deployment, or self-approval authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "policy_version",
    "decision_id",
    "policy_envelope_sha256",
    "status",
    "evaluated_at",
    "valid_until",
    "current_snapshot",
    "previous_snapshot",
    "paper_run_config",
    "governor_config_source",
    "selector_config",
    "policy",
    "prior_active_set_source",
    "prior_active_set_sha256",
    "prior_active_entries",
    "candidates",
    "selection_steps",
    "selected_entries",
    "truncated_candidates",
    "skipped_candidates",
    "additions",
    "removals",
    "retained_entries",
    "direction_counts",
    "gate_results",
    "gate_summary",
    "calculations",
    "reason_codes",
    "methodology",
    "per_output_operator_approval_required",
    "auto2d_verification",
    "authority",
    "authority_boundaries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "mode": {
      "type": "string",
      "const": "governed_dynamic_allowlist_decision"
    },
    "policy_version": {
      "type": "string",
      "enum": [
        "auto2c-v2-paper-automatic-acceptance-1",
        "auto2c-v2-first-bounded-paper-experiment-1"
      ]
    },
    "decision_id": {
      "$ref": "#/$defs/sha256"
    },
    "policy_envelope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "type": "string",
      "enum": [
        "POLICY_ELIGIBLE_FOR_AUTO2D_VERIFICATION",
        "GOVERNOR_BLOCKED"
      ]
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "current_snapshot": {
      "$ref": "#/$defs/snapshot_reference"
    },
    "previous_snapshot": {
      "$ref": "#/$defs/snapshot_reference"
    },
    "paper_run_config": {
      "$ref": "#/$defs/paper_run_config_reference"
    },
    "governor_config_source": {
      "$ref": "#/$defs/file_reference"
    },
    "selector_config": {
      "$ref": "#/$defs/selector_config"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "prior_active_set_source": {
      "type": "string",
      "enum": [
        "STATIC_PAPER_ALLOWLIST",
        "PREVIOUS_ACCEPTED_V2_PAPER_UNIVERSE"
      ]
    },
    "prior_active_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prior_active_entries": {
      "$ref": "#/$defs/exact_key_array"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "uniqueItems": true
    },
    "selection_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selection_step"
      },
      "uniqueItems": true
    },
    "selected_entries": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/selected_entry"
      },
      "uniqueItems": true
    },
    "truncated_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate_outcome"
      },
      "uniqueItems": true
    },
    "skipped_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate_outcome"
      },
      "uniqueItems": true
    },
    "additions": {
      "$ref": "#/$defs/exact_key_array"
    },
    "removals": {
      "$ref": "#/$defs/exact_key_array"
    },
    "retained_entries": {
      "$ref": "#/$defs/exact_key_array"
    },
    "direction_counts": {
      "$ref": "#/$defs/direction_counts"
    },
    "gate_results": {
      "$ref": "#/$defs/gate_results"
    },
    "gate_summary": {
      "$ref": "#/$defs/gate_summary"
    },
    "calculations": {
      "$ref": "#/$defs/calculations"
    },
    "reason_codes": {
      "$ref": "#/$defs/reason_code_array"
    },
    "methodology": {
      "$ref": "#/$defs/methodology"
    },
    "per_output_operator_approval_required": {
      "type": "boolean",
      "const": false
    },
    "auto2d_verification": {
      "$ref": "#/$defs/auto2d_verification"
    },
    "authority": {
      "type": "string",
      "const": "non_actuating_requires_independent_auto2d_verification"
    },
    "authority_boundaries": {
      "$ref": "#/$defs/authority_boundaries"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "exact_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id",
        "timeframe",
        "selected_variant",
        "direction"
      ],
      "properties": {
        "pair_id": {
          "description": "Exactly two non-empty full instrument identifiers separated by one double underscore.",
          "type": "string",
          "pattern": "^(?!.*__.*__)\\S+__\\S+$"
        },
        "timeframe": {
          "type": "string",
          "const": "1m"
        },
        "selected_variant": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "LONG_SPREAD",
            "SHORT_SPREAD"
          ]
        }
      }
    },
    "exact_key_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exact_key"
      },
      "uniqueItems": true
    },
    "snapshot_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "producer_git_sha",
        "schema_version",
        "generated_at",
        "source_cutoff_at",
        "selector_config_sha256",
        "selector_view_present",
        "selector_view_churn_available"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "producer_git_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "schema_version": {
          "type": "integer",
          "const": 2
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_cutoff_at": {
          "type": "string",
          "format": "date-time"
        },
        "selector_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selector_view_present": {
          "type": "boolean",
          "const": true
        },
        "selector_view_churn_available": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "paper_run_config_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "producer_git_sha",
        "static_allowlist_mode",
        "static_allowlist_entry_count"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "producer_git_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "static_allowlist_mode": {
          "type": "string",
          "const": "pair_variant_direction"
        },
        "static_allowlist_entry_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "file_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "selector_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_closed_positions",
        "min_avg_net_bps",
        "max_tail_loss_bps",
        "max_avg_exit_lag_seconds",
        "max_selected",
        "min_score"
      ],
      "properties": {
        "min_closed_positions": {
          "type": "integer",
          "minimum": 0
        },
        "min_avg_net_bps": {
          "type": "number"
        },
        "max_tail_loss_bps": {
          "type": "number"
        },
        "max_avg_exit_lag_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "max_selected": {
          "type": "integer",
          "minimum": 1
        },
        "min_score": {
          "type": "number"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_comparable_v2_snapshots",
        "min_source_cutoff_separation_seconds",
        "max_current_source_age_seconds",
        "min_selector_rows_each_snapshot",
        "min_trade_now_count_each_snapshot",
        "min_trade_now_ratio_each_snapshot",
        "require_positive_finite_selector_mean_net_edge",
        "max_selected_entries",
        "max_additions",
        "max_selector_exploration_entries",
        "min_selector_exploration_entries_when_qualified_and_transition_safe",
        "max_removals",
        "max_directions_per_pair_variant",
        "max_entries_per_pair_id",
        "max_entries_per_full_instrument",
        "max_new_additions_per_full_instrument",
        "max_churn_ratio",
        "churn_measure",
        "churn_denominator",
        "churn_floor_capacity",
        "decision_validity_seconds",
        "candidate_overflow_behavior",
        "concentration_overflow_behavior",
        "selection_allocation",
        "realized_lane_ranking",
        "exploration_lane_ranking",
        "fallback_behavior",
        "max_simultaneously_open_paper_positions",
        "max_open_paper_positions_per_pair_id",
        "max_open_paper_positions_per_full_instrument",
        "max_open_selector_exploration_positions",
        "max_open_positions_per_exact_key",
        "hold_window_bars",
        "cooldown_seconds",
        "max_candidate_age_seconds",
        "max_automatic_start_decision_age_seconds",
        "entry_window_seconds",
        "exit_only_grace_seconds",
        "controller_hard_runtime_seconds"
      ],
      "properties": {
        "required_comparable_v2_snapshots": {
          "type": "integer",
          "const": 2
        },
        "min_source_cutoff_separation_seconds": {
          "type": "integer",
          "const": 86400
        },
        "max_current_source_age_seconds": {
          "type": "integer",
          "const": 1800
        },
        "min_selector_rows_each_snapshot": {
          "type": "integer",
          "const": 12
        },
        "min_trade_now_count_each_snapshot": {
          "type": "integer",
          "const": 3
        },
        "min_trade_now_ratio_each_snapshot": {
          "type": "number",
          "const": 0.01
        },
        "require_positive_finite_selector_mean_net_edge": {
          "type": "boolean",
          "const": true
        },
        "max_selected_entries": {
          "type": "integer",
          "const": 4
        },
        "max_additions": {
          "type": "integer",
          "const": 2
        },
        "max_selector_exploration_entries": {
          "type": "integer",
          "const": 2
        },
        "min_selector_exploration_entries_when_qualified_and_transition_safe": {
          "type": "integer",
          "const": 1
        },
        "max_removals": {
          "oneOf": [
            {
              "type": "integer",
              "const": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "max_directions_per_pair_variant": {
          "type": "integer",
          "const": 2
        },
        "max_entries_per_pair_id": {
          "type": "integer",
          "const": 2
        },
        "max_entries_per_full_instrument": {
          "type": "integer",
          "const": 2
        },
        "max_new_additions_per_full_instrument": {
          "type": "integer",
          "const": 1
        },
        "max_churn_ratio": {
          "oneOf": [
            {
              "type": "number",
              "const": 0.5
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_route": {
          "type": "string",
          "const": "FIRST_BOUNDED_PAPER_EXPERIMENT"
        },
        "static_baseline_transition_behavior": {
          "type": "string",
          "const": "REPORT_OVERLAP_ONLY_NO_REMOVAL_OR_CHURN_GATE"
        },
        "trial_universe_scope": {
          "type": "string",
          "const": "CONTROLLER_OWNED_IMMUTABLE_TRIAL_ROOT_ONLY"
        },
        "post_trial_promotion_behavior": {
          "type": "string",
          "const": "SEPARATE_POLICY_DECISION_REQUIRED"
        },
        "churn_measure": {
          "type": "string",
          "const": "PRIOR_SELECTED_SYMMETRIC_DIFFERENCE"
        },
        "churn_denominator": {
          "type": "string",
          "const": "MAX_POLICY_CAPACITY_PRIOR_ACTIVE_COUNT"
        },
        "churn_floor_capacity": {
          "type": "integer",
          "const": 4
        },
        "decision_validity_seconds": {
          "type": "integer",
          "const": 108000
        },
        "candidate_overflow_behavior": {
          "type": "string",
          "const": "DETERMINISTIC_TRUNCATE_AND_RECORD"
        },
        "concentration_overflow_behavior": {
          "type": "string",
          "const": "SKIP_AND_CONTINUE"
        },
        "selection_allocation": {
          "type": "string",
          "const": "RESERVE_BEST_EXPLORATION_ADDITION_FILL_REALIZED_ALLOW_SECOND_ADDITION"
        },
        "realized_lane_ranking": {
          "type": "string",
          "const": "MIN_TOTAL_B2C_SCORE_DESC_MIN_CLOSED_COUNT_DESC_MIN_TRADE_NOW_RATIO_DESC_EXACT_KEY_ASC"
        },
        "exploration_lane_ranking": {
          "type": "string",
          "const": "MIN_TRADE_NOW_RATIO_DESC_MIN_TRADE_NOW_COUNT_DESC_MIN_SELECTOR_EDGE_DESC_EXACT_KEY_ASC"
        },
        "fallback_behavior": {
          "type": "string",
          "const": "NO_FALLBACK"
        },
        "max_simultaneously_open_paper_positions": {
          "type": "integer",
          "const": 2
        },
        "max_open_paper_positions_per_pair_id": {
          "type": "integer",
          "const": 1
        },
        "max_open_paper_positions_per_full_instrument": {
          "type": "integer",
          "const": 1
        },
        "max_open_selector_exploration_positions": {
          "type": "integer",
          "const": 1
        },
        "max_open_positions_per_exact_key": {
          "type": "integer",
          "const": 1
        },
        "hold_window_bars": {
          "type": "integer",
          "const": 5
        },
        "cooldown_seconds": {
          "type": "integer",
          "const": 300
        },
        "max_candidate_age_seconds": {
          "type": "integer",
          "const": 120
        },
        "max_automatic_start_decision_age_seconds": {
          "type": "integer",
          "const": 300
        },
        "entry_window_seconds": {
          "type": "integer",
          "const": 86400
        },
        "exit_only_grace_seconds": {
          "type": "integer",
          "const": 3600
        },
        "controller_hard_runtime_seconds": {
          "type": "integer",
          "const": 90000
        }
      }
    },
    "selector_window_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector_row_count",
        "trade_now_count",
        "time_in_trade_now_ratio",
        "selector_stated_mean_net_edge_bps"
      ],
      "properties": {
        "selector_row_count": {
          "type": "integer",
          "minimum": 12
        },
        "trade_now_count": {
          "type": "integer",
          "minimum": 3
        },
        "time_in_trade_now_ratio": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "selector_stated_mean_net_edge_bps": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "realized_window_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_b2c_score",
        "closed_position_count"
      ],
      "properties": {
        "total_b2c_score": {
          "type": "number"
        },
        "closed_position_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rank_components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_total_b2c_score",
        "minimum_closed_position_count",
        "minimum_trade_now_ratio",
        "minimum_trade_now_count",
        "minimum_selector_stated_mean_net_edge_bps",
        "exact_key_tiebreak"
      ],
      "properties": {
        "minimum_total_b2c_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "minimum_closed_position_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "minimum_trade_now_ratio": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "minimum_trade_now_count": {
          "type": "integer",
          "minimum": 3
        },
        "minimum_selector_stated_mean_net_edge_bps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "exact_key_tiebreak": {
          "type": "string",
          "pattern": "^\\S+__\\S+\\|1m\\|\\S+\\|(LONG_SPREAD|SHORT_SPREAD)$"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "evidence_class",
        "current_selector",
        "previous_selector",
        "current_realized",
        "previous_realized",
        "rank_components",
        "lane_rank",
        "absent_from_prior_active_set"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/exact_key"
        },
        "evidence_class": {
          "type": "string",
          "enum": [
            "REALIZED_AND_SELECTOR",
            "SELECTOR_EXPLORATION"
          ]
        },
        "current_selector": {
          "$ref": "#/$defs/selector_window_metrics"
        },
        "previous_selector": {
          "$ref": "#/$defs/selector_window_metrics"
        },
        "current_realized": {
          "oneOf": [
            {
              "$ref": "#/$defs/realized_window_metrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_realized": {
          "oneOf": [
            {
              "$ref": "#/$defs/realized_window_metrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "rank_components": {
          "$ref": "#/$defs/rank_components"
        },
        "lane_rank": {
          "type": "integer",
          "minimum": 1
        },
        "absent_from_prior_active_set": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_class": {
                "const": "REALIZED_AND_SELECTOR"
              }
            },
            "required": [
              "evidence_class"
            ]
          },
          "then": {
            "properties": {
              "current_realized": {
                "$ref": "#/$defs/realized_window_metrics"
              },
              "previous_realized": {
                "$ref": "#/$defs/realized_window_metrics"
              },
              "rank_components": {
                "properties": {
                  "minimum_total_b2c_score": {
                    "type": "number"
                  },
                  "minimum_closed_position_count": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "current_realized": {
                "type": "null"
              },
              "previous_realized": {
                "type": "null"
              },
              "rank_components": {
                "properties": {
                  "minimum_total_b2c_score": {
                    "type": "null"
                  },
                  "minimum_closed_position_count": {
                    "type": "null"
                  }
                }
              },
              "absent_from_prior_active_set": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "selected_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "evidence_class",
        "lane_rank",
        "selection_sequence",
        "selection_rule"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/exact_key"
        },
        "evidence_class": {
          "type": "string",
          "enum": [
            "REALIZED_AND_SELECTOR",
            "SELECTOR_EXPLORATION"
          ]
        },
        "lane_rank": {
          "type": "integer",
          "minimum": 1
        },
        "selection_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "selection_rule": {
          "type": "string",
          "enum": [
            "RESERVE_BEST_QUALIFYING_ADDITION",
            "FILL_REALIZED_SUPPORTED",
            "FILL_SECOND_QUALIFYING_ADDITION"
          ]
        }
      }
    },
    "selection_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "rule",
        "candidate_key",
        "result"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "rule": {
          "type": "string",
          "enum": [
            "RESERVE_BEST_QUALIFYING_ADDITION",
            "FILL_REALIZED_SUPPORTED",
            "FILL_SECOND_QUALIFYING_ADDITION",
            "SKIP_CONCENTRATION_AND_CONTINUE",
            "TRUNCATE_AT_CAPACITY"
          ]
        },
        "candidate_key": {
          "$ref": "#/$defs/exact_key"
        },
        "result": {
          "type": "string",
          "enum": [
            "SELECTED",
            "SKIPPED",
            "TRUNCATED"
          ]
        }
      }
    },
    "candidate_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "evidence_class",
        "lane_rank",
        "reason_code"
